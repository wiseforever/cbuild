{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true
    },
    "git.enabled": false,
    "git.autorefresh": false,
    "git.autofetch": false,
    "git.autoRepositoryDetection": false,
    "files.autoGuessEncoding": false,
    "files.encoding": "utf8",
    "files.eol": "\n",
    "editor.renderWhitespace": "all",
    "editor.tabSize": 4,
    /* 是否自动检测文件的缩进规则 */
    "editor.detectIndentation": false,
    /* tab 是否替换为空格 需要检测 editor.detectIndentation */
    "editor.insertSpaces": true,
    "editor.mouseWheelZoom": true,
    "editor.fontFamily": "Cascadia Code, 'Microsoft YaHei Mono', monospace",
    // "terminal.integrated.fontFamily": "Cascadia Code, 'Microsoft YaHei Mono', monospace",
    "terminal.integrated.fontFamily": "Consolas, 'Courier New', monospace",
    "terminal.integrated.detectLocale": "off",
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.fontWeight": "normal",
    "terminal.integrated.shellIntegration.enabled": false,
    /* Windows 上的默认终端配置文件。 */
    "terminal.integrated.profiles.windows": {
        "MSYS2(msys)": {
            "path": "C:/msys64/usr/bin/bash.exe",
            "args": [
                "-i"
            ]
        },
        "Git Bash": {
            "source": "Git Bash",
            "icon": "terminal-bash",
            "args": [
                "--login",
                "-i"
            ],
            "env": {
                "LANG": "zh_CN.UTF-8",
                "LC_ALL": "zh_CN.UTF-8",
                "LESSCHARSET": "utf-8"
            }
        },
        "PowerShell": {
            "path": [
                "${env:windir}/Sysnative/WindowsPowerShell/v1.0/powershell.exe",
                "${env:windir}/System32/WindowsPowerShell/v1.0/powershell.exe"
            ],
            "args": [],
            "icon": "terminal-powershell"
        },
        "Command Prompt": {
            "path": [
                "${env:windir}/Sysnative/cmd.exe",
                "${env:windir}/System32/cmd.exe"
            ],
            "args": [],
            "icon": "terminal-cmd"
        }
    },
    "terminal.integrated.env.windows": {
        "LANG": "zh_CN.UTF-8",
        "LC_ALL": "zh_CN.UTF-8"
    },
    // "terminal.integrated.defaultProfile.windows":"",
    /* C/C++ 扩展的配置 */
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.autoAddFileAssociations": false,
    /* clangd的配置 */
    "clangd.path": "clangd",
    "clangd.enable": true,
    "clangd.enableCodeCompletion": true,
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build",
        "--header-insertion=never",
        "--all-scopes-completion",
        "--clang-tidy"
    ],
    "editor.inlayHints.enabled": "offUnlessPressed",
    // "editor.formatOnSave": true,
    // 指定 clang-format 可执行文件
    "clang-format.executable": "clang-format",
    // 让 clang-format 自动查找最近的 .clang-format 文件
    "clang-format.style": "file",
    // 如果没有找到 .clang-format，则使用备用托底
    // "clang-format.fallbackStyle": "Google",
    "clang-format.fallbackStyle": "microsoft",
    // 指定 VS Code 对 C/C++ 默认使用 clang-format
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    "[c]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    "VsCodeTaskButtons.showCounter": false,
    "VsCodeTaskButtons.tasks": [
        {
            "label": "$(archive)",
            "task": "conan",
            "tooltip": "conan"
        },
        {
            "label": "$(gear)",
            "task": "generate",
            "tooltip": "generate cmake cache"
        },
        {
            "label": "$(wrench)",
            "task": "build",
            "tooltip": "build"
        },
        {
            "label": "$(run)",
            "task": "run",
            "tooltip": "run"
        },
        {
            "label": "$(package)",
            "task": "deploy",
            "tooltip": "deploy"
        },
        {
            "label": "$(arrow-swap)    |",
            "task": "switch",
            "tooltip": "Debug/Release switch"
        },
        {
            "label": "$(trash)",
            "task": "clean",
            "tooltip": "clean"
        },
        /* 
        
        */
    ],
    "files.associations": {
        "*.json": "jsonc",
        "*.c": "c",
        "*.h": "c",
        "*.cpp": "cpp",
        "*.hpp": "cpp",
        "*.cc": "cpp",
        "*.hh": "cpp"
    },
}
