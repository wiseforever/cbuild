{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "conan",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "python",
            "args": [
                "cb.py",
                "--conan"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "type": "shell",
            "label": "generate",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "python",
            "args": [
                "cb.py",
                "-g"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "type": "shell",
            "label": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "python",
            "args": [
                "cb.py",
                "-b"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "type": "shell",
            "label": "clean",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "python",
            "args": [
                "cb.py",
                "-c"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "type": "shell",
            "label": "run",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "python",
            "args": [
                "cb.py",
                "-r"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "dependsOn": [
                "build"
            ]
        },
        {
            "type": "shell",
            "label": "switch",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "python",
            "args": [
                "cb.py",
                "-t"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "type": "shell",
            "label": "deploy",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "python",
            "args": [
                "cb.py",
                "-b",
                "--target",
                "deploy"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}

